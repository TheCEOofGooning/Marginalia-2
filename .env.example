# ---------------------------------------------------------------------------
# Marginalia — environment variables
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# On Vercel, add the same names under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# REQUIRED to persist anything. Neon console → your project → Connect → the
# "Pooled connection" string (host looks like ep-xxx-pooler.eu-central-1.aws.neon.tech).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional. TLS behaviour for the Postgres client: "require" or "disable".
# Leave unset and Marginalia enables TLS for every non-localhost host.
# DATABASE_SSL="require"

# Optional. Max clients in the pool (default 5). Keep this small on serverless.
# PG_POOL_MAX="5"

# Optional. Enables DELETE /api/posts/:id. There is no authentication in this
# build, so anyone with the URL could delete pieces — leave it off in public.
# ALLOW_DELETES="0"

# Optional. Extra origins allowed to load the dev server (comma separated).
# ALLOWED_DEV_ORIGINS="my-tunnel.example.com"

# Optional. Show the Postgres status line at the bottom of the feed even in a
# production build (it is always shown by `next dev`).
# SHOW_DB_STATUS="1"
